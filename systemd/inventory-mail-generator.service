[Unit]
Description=Inventory Automation Web App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/path/to/inventory-automation
EnvironmentFile=-/etc/default/inventory-mail-generator
ExecStart=/path/to/inventory-automation/run_web_service.sh
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
