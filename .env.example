# HTTPS port. HTTP will listen on PORT + 1.
PORT=3000

# OpenAI-compatible OCR endpoint and credentials (Gemini supported).
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Primary key is always used last after AI_API_KEYS rotation.
AI_API_KEY=replace_with_primary_key

# Comma-separated fallback keys used before AI_API_KEY.
AI_API_KEYS=replace_with_fallback_key_1,replace_with_fallback_key_2

AI_MODEL=gemini-2.5-flash
